{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zimdigital",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Rezervna adresa *.workers.dev — ostaje uključena da uvek postoji
  // način da se sajt otvori i kada je nešto sa domenom u kvaru.
  "workers_dev": true,
  // Custom domains — wrangler sam pravi i održava DNS zapise za njih.
  // Kanonska adresa je apex; www postoji da ne pukne kome je u obeleživačima,
  // a canonical tagovi sa svake strane vode na apex.
  //
  // Napomena: ako se ovde ikada pojavi `409 Conflict`, znači da u DNS-u
  // postoji ručno napravljen zapis na istom imenu — obriši ga pa ponovi.
  "routes": [
    { "pattern": "zimdigital.rs", "custom_domain": true },
    { "pattern": "www.zimdigital.rs", "custom_domain": true }
  ],
  // Adrese za kontakt formu — nisu tajne, pa stoje ovde.
  // Tajni RESEND_API_KEY se postavlja preko: npx wrangler secret put RESEND_API_KEY
  //
  // CONTACT_FROM_EMAIL je za sada Resend-ova test adresa, koja sme da šalje
  // isključivo na email vlasnika Resend naloga. Kada verifikuješ domen na
  // Resend-u, zameni je sa npr. "ZIM Digital <sajt@zimdigital.rs>".
  "vars": {
    "CONTACT_FROM_EMAIL": "ZIM Digital <onboarding@resend.dev>",
    "CONTACT_TO_EMAIL": "zimstudioonline@gmail.com"
  },
  "observability": {
    "enabled": true
  }
}
